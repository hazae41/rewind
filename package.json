  "files": [
    "./out"
  ],
  "exports": {
    ".": {
      "types": "./out/mod.d.ts",
      "import": "./out/mod.js"
    }
  },
  "peerDependencies": {
    "tailwindcss": ">=4.0.0"
  },
  "devDependencies": {
    "@hazae41/tscousin": "^1.0.28",
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2"
  }
}